,"key":"HJekYvqcuV"}],"key":"YYgTnEO7Sy"}],"key":"IsFYkco1Ay"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Methods and assumptions","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"OTJ5L6910Y"}],"identifier":"methods-and-assumptions","label":"Methods and assumptions","html_id":"methods-and-assumptions","implicit":true,"key":"pZpf1nQ5kN"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"This is an observational analysis. We assume the station weather is a reasonable proxy for city conditions and that the date merge is correct. We treat missing or special coded weather values as missing during cleaning. We use correlation plots and simple regressions with robust standard errors. We also add day of week controls to reduce obvious calendar confounding. (see cleaner.ipynb)","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"aJc0mty8C7"}],"key":"Mm0AD2eUtk"}],"key":"a3RMsTftnB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-16T07:54:33.743332Z","iopub.status.busy":"2025-12-16T07:54:33.742979Z","iopub.status.idle":"2025-12-16T07:54:33.747531Z","shell.execute_reply":"2025-12-16T07:54:33.746930Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nif not os.path.isdir(\"src\"):\n    os.chdir(\"..\")","key":"ZJyxzBULR9"},{"type":"outputs","id":"iZ77o8WaN5vm4cbHCWb3j","children":[],"key":"tu1sRopL2e"}],"key":"q2Vq0za2VC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2025-12-16T07:54:33.750001Z","iopub.status.busy":"2025-12-16T07:54:33.749783Z","iopub.status.idle":"2025-12-16T07:54:34.198612Z","shell.execute_reply":"2025-12-16T07:54:34.197894Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nf
ing","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Project Deliverables","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"O5M3sF8wij"}],"identifier":"project-deliverables","label":"Project Deliverables","html_id":"project-deliverables","implicit":true,"key":"clifS9EOcp"},{"type":"heading","depth":3,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Data","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"vixbv2LNIP"}],"identifier":"data","label":"Data","html_id":"data","implicit":true,"key":"SDbbf1QBnP"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"You should aim to store your data in your GitHub repository. Depending on the size of your data, you may choose to include it in the repository or not (use your judgment - up to a few dozen megabytes it’s not a problem, something in the Gigabyte range is too big to put into a repository). If the data cannot be included in the repository, your code should access it remotely and store more manageable subsets of it relevant for plotting (similar to what we recommended for Project 1 and Project 2). If you don’t include the data in the repository, consider the implications of doing so for long-term reproducibility: is the source you are using a reliable one? Will it be there in 10 years? You can also explore other ways of storing datasets, such as Zenodo or Huggingface.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"AIiioHd1TV"}],"key":"WTPxtYORAd"},{"type":"heading","depth":3,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Functional structure of your code and testing","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"zBFO2I5KKP"}],"identifier":"functional-structure-of-your-code-and-testing","label":"Functional structure of your code and testing","html_id":"functional-structure-of-your-code-and-testing","implicit":true,"key":"ychlh2yPpC"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"You should identify steps amenable to be put into standalone functions and write a proper function for those, with a complete docstring describing the purpose of the function, their inputs and types, and their outputs.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ASKyBcZN6a"}],"key":"iNuvc2dVTF"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"You may choose to put analysis functions into a pure Python file that you import separately or in the Jupyter notebook itself. Make the choice that you find cleanest/most fluid for your workflow.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"wxKgBh9jSf"}],"key":"pM0t9yBPAw"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Whether you do it in a notebook or python scripts, make sure to write at least a few tests for utility functions that you write.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Qh0begwBJh"}],"key":"hYhD8DF7H3"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Note:","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"ua04BMSGKQ"}],"key":"HJ7RLgnvuu"},{"type":"text","value":" this is a ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"MuFOMn7wjM"},{"type":"emphasis","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"requirement","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"jVdY2pADLH"}],"key":"zW42wVFJOY"},{"type":"text","value":". You must structure your code to include at least two functions that you import from a separate python script, that you test and document properly (feel free to use more as your analysis dictates).","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"jvY6hH3Lc8"}],"key":"KmOdNu2prx"},{"type":"heading","depth":3,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Analysis notebooks and supporting code","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"dF50QWTJds"}],"identifier":"analysis-notebooks-and-supporting-code","label":"Analysis notebooks and supporting code","html_id":"analysis-notebooks-and-supporting-code","implicit":true,"key":"FaiUFMezwA"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Break down your analysis into as many notebooks as is reasonable for convenient reading and execution. There is no hard and fast rule for this, just as there isn’t for how many paragraphs or figures a good scientific paper should have. You should consider readability, execution time, total notebook length, etc, as criteria in your decisions.  ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"mIfVHA5MO0"},{"type":"link","url":"http://blog.wolfram.com/2017/11/14/what-is-a-computational-essay","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"This essay","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"dTAq2Kn9EQ"}],"urlSource":"http://blog.wolfram.com/2017/11/14/what-is-a-computational-essay","key":"qJurOgN3IT"},{"type":"text","value":" by Stephen Wolfram, the creator of Mathematica (part of the inspiration for the Jupyter Notebook), has some good thoughts on what makes a well written computational narrative.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"EUGGV3hGXe"}],"key":"SdbbsneukI"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Consider how to “chain” your analyses with intermediate results being stored so they don’t need to be recomputed from scratch each time. Also, be mindful of saving key figures you may want to reuse in your report to disk, so the main narrative notebook can reuse them for display and discussion.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"b5ZyDvKd8f"}],"key":"Canf7WDWvF"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"You must also render all of your analysis notebooks each as a separate PDF file using MyST and store them in a directory called ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"DNVixZ51q1"},{"type":"inlineCode","value":"pdf_builds","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"vgWXOk2857"},{"type":"text","value":". You’re going to be making your projects into MyST projects and deploying them to websites later; as discussed in the MyST lecture, MyST also let’s you render notebooks and markdown files as PDFs.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"LsgM7AAvp6"}],"key":"kwKq2cRgHj"},{"type":"heading","depth":3,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Main narrative notebook","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"yUsyTZRq82"}],"identifier":"main-narrative-notebook","label":"Main narrative notebook","html_id":"main-narrative-notebook","implicit":true,"key":"ElmQXxfE2V"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Write a ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"staIS5Etk1"},{"type":"inlineCode","value":"main.ipynb","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"bOUZCWYBOq"},{"type":"text","value":" notebook that summarizes and discusses your results. It can contain figures referenced from disk or simple summary information (for example if you want to display part of a dataframe) from variables read from disk, but ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"yBE5FxdWx2"},{"type":"emphasis","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"no significant computations at all","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"HwuLChd3ID"}],"key":"can9c9bmNP"},{"type":"text","value":". Think of this as your “paper”.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"I2KZBB1zLq"}],"key":"grLcXIVhYS"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Discuss the assumptions you can make about the data to justify your analysis. You have no control over the original data acquisition and measurement, and for many of you this project will likely fall under the broad purview of ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"dTuh05re4l"},{"type":"emphasis","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Exploratory Data Analysis","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"sror3bGDAC"}],"key":"jaITIfFgoz"},{"type":"text","value":".  If you propose any statistical hypothesis/model in your analysis, discuss your justifications, considering how the data was acquired. We are not expecting you to spend a lot of time dealing with how to best model or describe the data. Try to identify a few scientifically interesting but simple questions you can address and then focus on writing the code for such an analysis.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"D9FoP22GTQ"}],"key":"Bu6tLPZjje"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"strong","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Author Contributions section:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"aSjytSQqyk"}],"key":"hhOzJnLQRD"},{"type":"text","value":" your ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"OJrUqwFMLH"},{"type":"inlineCode","value":"main.ipynb","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Nc7FYnjwKJ"},{"type":"text","value":" notebook should contain, at the end, a brief section titled ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"gk5g1BS88M"},{"type":"emphasis","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Author Contributions","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"oi6LY2Tk5p"}],"key":"q1IjiBCGAw"},{"type":"text","value":". This section should indicate, for each team member, what they did in the project. It doesn’t have to be a long, detailed story, a few sentences per person should suffice.  All team members must agree to the language in this section.  (By the way, this is standard practice in many scientific journals).  While in principle the project grade is the same for all team members, we reserve the right to lower the grade of anyone who doesn’t contribute to the team effort.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"cUHqaIkGEp"}],"key":"LvYnzM8SrD"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Like with each of the analysis notebooks in the previous section, you should also build your main narrative as a PDF using MyST. Please also include a bibliography of works that you cite. This could be previous work that motivates the question you are investigating and why it’s interesting, any methods that you might be employing from the literature, or the dataset you are using. We ask that you do this by including all of your references in a ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"EI3qQt1ZwF"},{"type":"inlineCode","value":"BibTeX","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"zY2CEPUBJr"},{"type":"text","value":" file and cite them in this main narrative by referencing the relevant entry in your ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"mOT1TDHhDe"},{"type":"inlineCode","value":"BibTeX","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GoCBGoBviD"},{"type":"text","value":" file. For more details, see the Lab 8 material.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"P6u3Oa8Rlt"}],"key":"flOBfP9GQu"},{"type":"heading","depth":3,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Reproducibility support","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"YcJ8x5jyCT"}],"identifier":"reproducibility-support","label":"Reproducibility support","html_id":"reproducibility-support","implicit":true,"key":"Nci9llFp1G"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":47,"column":1},"end":{"line":52,"column"